# Copy to .env (gitignored) and fill in. `make run` loads it; by hand:
#   set -a && . ./.env && set +a && ./bin/scan-hub
# ScanSnap iX500 (give it a fixed DHCP reservation).
SCANHUB_SCANSNAP_IP=192.168.1.50
# ScanSnap Wi-Fi password (factory default: last 4 digits of the serial).
SCANHUB_SCANSNAP_PASSWORD=
# Local development: keep data inside the repo (gitignored /data/).
SCANHUB_DATA_DIR=/home/you/dev/scan-hub/data
SCANHUB_LISTEN_ADDR=127.0.0.1:8097
SCANHUB_LOG_LEVEL=info
# Epson eSCL scanner. Pin = SHA-256 of the device certificate's SPKI (or of the
# whole certificate). Capture:
#   echo | openssl s_client -connect 192.168.1.60:443 2>/dev/null | openssl x509 -pubkey -noout \
#     | openssl pkey -pubin -outform der | openssl dgst -sha256
SCANHUB_EPSON_URL=https://192.168.1.60
SCANHUB_EPSON_TLS_PIN=
# Paperless-ngx: use a dedicated least-privilege user with only add_document
# and view_paperlesstask.
SCANHUB_PAPERLESS_URL=https://paperless.example.com
SCANHUB_PAPERLESS_TOKEN=
# SCANHUB_PAPERLESS_TAGS=12,34
